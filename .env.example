# =============================================================================
# DeckPilot configuration  -  copy this file to ".env" (it is git-ignored).
# This is the ONE place to change the model, the reasoning level, the key and
# the quality settings. No code changes needed.
#
#   After editing .env:
#     Docker Compose : docker compose up -d          (picks up the new values)
#     Kubernetes     : .\scripts\sync-config.ps1      (pushes them into the cluster)
#
# Rules: one KEY=value per line, no spaces around "=", no comments after a value.
# =============================================================================

# ---- 1. Mode ---------------------------------------------------------------
# azure = real Microsoft Foundry model + web search,  mock = offline canned data
LLM_PROVIDER=azure

# ---- 2. Connection and key (the key is never committed anywhere) ------------
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
# The model used by every agent unless overridden below. This is the DEPLOYMENT
# name shown in Foundry (Deployments page), not the base model name.
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# ---- 3. Reasoning level ("thinking") ----------------------------------------
# Typical values: none, low, medium, high. Higher = better but slower and costlier.
# "default" sends no reasoning setting at all. Leave empty for non-reasoning models.
# Note: very low settings such as "minimal" are not accepted together with web
# search by some models. If a value is rejected, the error shows in the app's
# Activity list.
LLM_REASONING_EFFORT=low
# Per-agent overrides (empty = use LLM_REASONING_EFFORT). The builder writes the
# whole storyline, so it gets medium by default. Try high for the best decks.
INTAKE_REASONING_EFFORT=
RESEARCH_REASONING_EFFORT=
SEARCH_REASONING_EFFORT=
BUILDER_REASONING_EFFORT=medium

# ---- 4. Different model per agent (optional) --------------------------------
# Put another deployment name here to use a different model for just that agent,
# for example a stronger model for BUILDER_MODEL. Empty = AZURE_OPENAI_DEPLOYMENT.
# INTAKE = brief check, RESEARCH = planning and synthesis, SEARCH = the web
# search calls themselves, BUILDER = slide outline.
INTAKE_MODEL=
RESEARCH_MODEL=
SEARCH_MODEL=
BUILDER_MODEL=

# ---- 5. Quality and cost knobs ----------------------------------------------
# Web research questions per deck (1-10). More = deeper research, more search cost.
MAX_QUERIES=6
# Add Wikipedia images to slides where relevant (true/false)
ENABLE_IMAGES=true
# Colour theme used when the user does not pick one: executive, graphite, forest, aubergine
DEFAULT_THEME=executive
# Seconds a single model call may take, and optional cap on output tokens
LLM_TIMEOUT=180
LLM_MAX_OUTPUT_TOKENS=
# Seconds the orchestrator waits for each agent before giving up
INTAKE_TIMEOUT=120
RESEARCH_TIMEOUT=600
BUILD_TIMEOUT=420
